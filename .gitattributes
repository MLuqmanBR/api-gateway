# M77: EOL policy — a Windows checkout must never CRLF-ify the shell
# installers or Python sources (bash chokes on CRLF shebangs).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.png binary

# Force GitHub Linguist to classify all .ts/.tsx files as TypeScript,
# even when they contain no TypeScript-specific syntax (e.g. pure-JS
# config/tooling scripts with a .ts extension). Without this, Linguist's
# content heuristics reclassify such files as JavaScript.
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# package-lock.json is auto-generated — exclude it from language stats.
package-lock.json linguist-generated
